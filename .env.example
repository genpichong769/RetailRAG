# LLM
DASHSCOPE_API_KEY=your_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus

# MySQL (also consumed by docker/mysql/docker-compose.yml)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=retailrag
MYSQL_PASSWORD=your_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=retailrag

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
FAQ_CACHE_TTL=86400
FAQ_CACHE_NAMESPACE=retailrag:v1
FAQ_RETRIEVAL_MODE=dense
FAQ_MATCH_THRESHOLD=0.84
FAQ_ALGORITHM_VERSION=dense-bgem3-v1

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE_NAME=retailrag
MILVUS_COLLECTION_NAME=retailrag_v1

# MinIO used by the local Milvus stack
MINIO_ACCESS_KEY=your_minio_user_here
MINIO_SECRET_KEY=your_minio_password_here

# Optional local overrides
# BGE_M3_PATH=rag_qa/models/bge-m3
# BGE_RERANKER_PATH=rag_qa/models/bge-reranker-large
# QUERY_CLASSIFIER_MODEL_PATH=rag_qa/models/retail-query-classifier
# LOG_FILE=logs/app.log
EVIDENCE_RERANKER_THRESHOLD=0.020635
QUERY_REWRITE_ENABLED=true
CUSTOMER_SERVICE_PHONE=门店值班经理或内部服务台
